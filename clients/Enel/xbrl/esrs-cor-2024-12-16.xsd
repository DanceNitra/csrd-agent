<?xml version="1.0" encoding="UTF-8"?>
<!--
ESRS Core Taxonomy 2024-12-16 — CSRD Agent local schema
Uses only valid XBRL item types per xbrli namespace.
-->
<xs:schema 
    targetNamespace="http://xbrl.efrag.org/sites/esrs/2024-12-16/esrs-cor"
    xmlns:esrs="http://xbrl.efrag.org/sites/esrs/2024-12-16/esrs-cor"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xbrli="http://www.xbrl.org/2003/instance"
    xmlns:link="http://www.xbrl.org/2003/linkbase"
    elementFormDefault="qualified"
    attributeFormDefault="unqualified">

    <xs:import namespace="http://www.xbrl.org/2003/instance" schemaLocation="http://www.xbrl.org/2003/xbrl-instance-2003-12-31.xsd"/>

    <!-- ── E1 Climate ── -->
    <xs:element name="GHGScope1Emissions" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="GHGScope2LocationBasedEmissions" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="GHGScope2MarketBasedEmissions" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="GHGScope3Emissions" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="GHGTotalEmissions" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="EnergyConsumptionTotal" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="GHGIntensity" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="GHGReductionTarget2030" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="InternalCarbonPrice" type="xbrli:monetaryItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="RenewableEnergyShare" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="TransitionPlanClimateMitigation" type="xbrli:booleanItemType" substitutionGroup="xbrli:item" xbrli:periodType="instant"/>

    <!-- ── E2 Pollution ── -->
    <xs:element name="NOxEmissions" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="SOxEmissions" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="ParticulateMatterEmissionsTotal" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="HazardousWasteGenerated" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>

    <!-- ── E3 Water ── -->
    <xs:element name="WaterWithdrawalTotal" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="WaterConsumptionTotal" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="WaterDischargeTotal" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>

    <!-- ── E5 Circular Economy ── -->
    <xs:element name="WasteGeneratedTotal" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="WasteDiversionRate" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>

    <!-- ── S1 Workforce ── -->
    <xs:element name="TotalEmployees" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="instant"/>
    <xs:element name="InjuryRateRecordable" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="FatalitiesWorkRelated" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="EmployeeTurnoverRate" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="GenderDiversityManagement" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="instant"/>
    <xs:element name="GenderPayGapMean" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>

    <!-- ── G1 Business Conduct ── -->
    <xs:element name="CorruptionConvictions" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="CorruptionFines" type="xbrli:monetaryItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="LobbyingExpenditure" type="xbrli:monetaryItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="RevenueTotal" type="xbrli:monetaryItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>
    <xs:element name="AveragePaymentDays" type="xbrli:decimalItemType" substitutionGroup="xbrli:item" xbrli:periodType="duration"/>

</xs:schema>